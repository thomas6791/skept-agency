---
import ContactForm from '../components/ContactForm.astro';
import '../styles/home.css';
title: "Skept - Agence Search & SEO"
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Skept - Agence Search & SEO" />
		<title>Skept - Agence Search & SEO</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="container">
			<div class="header">
				<h1>Skept</h1>
				<div class="subtitle">
					<span class="construction-icon">🚀</span>
					Site en construction
				</div>
				<p class="description">
					Nous sommes en train de créer quelque chose d'extraordinaire. En attendant, n'hésitez pas à nous contacter !
				</p>
			</div>

			<div class="form-section">
				<h2 class="form-title">Restez en contact</h2>
				<div class="form-wrapper">
					<ContactForm />
				</div>
			</div>
		</div>
	</body>
</html>
